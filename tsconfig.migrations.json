{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "outDir": "./dist-electron",
    "rootDir": "./electron",
    "declaration": false
  },
  "include": ["electron/migrations/**/*.ts"],
  "exclude": ["node_modules"]
}
